---
{% assign concept = site.data.concepts[page.concept_slug] %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ concept.title | escape }} | Interactive Knowledge Lexicon</title>
  <meta name="description" content="{{ concept.description | escape }}">
  <link rel="stylesheet" href="{{ '/css/proof.css' | relative_url }}">
</head>
<body>

  <header class="site-header">
    <a href="{{ '/' | relative_url }}" class="site-brand">
      Interactive Knowledge Lexicon
    </a>
    <span>Explore. Understand. Experiment.</span>
  </header>

  <main class="concept-container">

    {% if concept %}

      <section class="concept-introduction">
        <p class="concept-subject">{{ concept.subject }}</p>
        <h1>{{ concept.title | escape }}</h1>
        <p>{{ concept.description | escape }}</p>
      </section>

      <section class="learning-objectives">
        <h2>What you will learn</h2>
        <ul>
          {% for objective in concept.learning_objectives %}
            <li>{{ objective.text | escape }}</li>
          {% endfor %}
        </ul>
      </section>

      <section class="concept-content">
        <h2>Explore the concept</h2>

        {% for content_id in concept.content_blocks %}
          {% assign content_block = site.learning_content | where: "content_block_id", content_id | first %}

          {% if content_block %}
            {% include concept/content-block.html content_block=content_block %}
          {% else %}
            <p>Content block not found: {{ content_id | escape }}</p>
          {% endif %}

        {% endfor %}
      </section>

    {% else %}

      <section class="error-message">
        <h1>Concept not found</h1>
        <p>The requested concept record could not be located.</p>
      </section>

    {% endif %}

  </main>

  <footer class="site-footer">
    <p>Interactive Knowledge Lexicon</p>
    <p>Explore. Understand. Experiment.</p>
  </footer>

</body>
</html>
