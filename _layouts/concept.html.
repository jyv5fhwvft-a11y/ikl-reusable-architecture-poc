---
---
{% assign concept = site.data.concepts[page.concept_slug] %}
{% assign learning_collection = site.collections | where: "label", "learning_content" | first %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ concept.title | escape }} | Interactive Knowledge Lexicon</title>
  <meta name="description" content="{{ concept.description | escape }}">
  <link rel="stylesheet" href="{{ '/css/proof.css' | relative_url }}">
</head>
<body>

  <header class="site-header">
    <a href="{{ '/' | relative_url }}" class="site-brand">
      Interactive Knowledge Lexicon
    </a>
    <span>Explore. Understand. Experiment.</span>
  </header>

  <main class="concept-container">

    {% if concept %}

      <section class="concept-introduction">
        <p class="concept-subject">{{ concept.subject }}</p>
        <h1>{{ concept.title | escape }}</h1>
        <p>{{ concept.description | escape }}</p>
      </section>

      <section class="learning-objectives">
        <h2>What you will learn</h2>
        <ul>
          {% for objective in concept.learning_objectives %}
            <li>{{ objective.text | escape }}</li>
          {% endfor %}
        </ul>
      </section>

      <!-- TEMPORARY COLLECTION DIAGNOSTIC -->
      <section class="collection-diagnostic">
        <h2>Temporary Collection Diagnostic</h2>

        <h3>Check 1: Collection registration</h3>

        {% if learning_collection %}
          <p>Collection registered: YES</p>
          <p>Collection label: {{ learning_collection.label }}</p>
          <p>Documents in collection: {{ learning_collection.docs.size }}</p>
        {% else %}
          <p>Collection registered: NO</p>
        {% endif %}

        <h3>Check 2: Direct collection access</h3>
        <p>Documents in site.learning_content: {{ site.learning_content.size }}</p>

        <h3>Check 3: Loaded document details</h3>

        {% if learning_collection and learning_collection.docs.size > 0 %}

          <ul>
            {% for document in learning_collection.docs %}
              <li>
                <p>Document path: {{ document.relative_path }}</p>
                <p>Document ID: {{ document.id | default: "MISSING" }}</p>
                <p>Concept ID: {{ document.concept_id | default: "MISSING" }}</p>
              </li>
            {% endfor %}
          </ul>

        {% else %}
          <p>No documents were found in the registered collection.</p>
        {% endif %}

        <h3>Check 4: Ping content block</h3>

        {% assign diagnostic_ping = learning_collection.docs | where: "id", "IKL-CN-001-CB-01" | first %}

        {% if diagnostic_ping %}
          <p>Ping content block found: YES</p>
          <p>Matched document: {{ diagnostic_ping.relative_path }}</p>
        {% else %}
          <p>Ping content block found: NO</p>
        {% endif %}

      </section>
      <!-- END TEMPORARY COLLECTION DIAGNOSTIC -->

      <section class="concept-content">
        <h2>Explore the concept</h2>

        {% for content_id in concept.content_blocks %}
          {% assign content_block = site.learning_content | where: "id", content_id | first %}

          {% if content_block %}
            {% include concept/content-block.html content_block=content_block %}
          {% else %}
            <p>Content block not found: {{ content_id | escape }}</p>
          {% endif %}

        {% endfor %}
      </section>

    {% else %}

      <section class="error-message">
        <h1>Concept not found</h1>
        <p>The requested concept record could not be located.</p>
      </section>

    {% endif %}

  </main>

  <footer class="site-footer">
    <p>Interactive Knowledge Lexicon</p>
    <p>Explore. Understand. Experiment.</p>
  </footer>

</body>
</html>
