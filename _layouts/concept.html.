---
---
{% assign concept = site.data.concepts[page.concept_slug] %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ concept.title | escape }} | Interactive Knowledge Lexicon</title>

  <meta
    name="description"
    content="{{ concept.description | escape }}"
  >

  <meta name="theme-color" content="#102A43">

  <link
    rel="stylesheet"
    href="{{ '/css/proof.css' | relative_url }}"
  >
</head>

<body>

  <!-- =====================================
       IKL SHARED HEADER
       ===================================== -->

  <header class="site-header">
    <a
      href="{{ '/' | relative_url }}"
      class="site-brand"
      aria-label="Interactive Knowledge Lexicon home"
    >
      Interactive Knowledge Lexicon
    </a>

    <span>Explore. Understand. Experiment.</span>
  </header>


  <!-- =====================================
       MAIN CONCEPT PAGE
       ===================================== -->

  <main class="concept-container">

    {% if concept %}

      <!-- CONCEPT INTRODUCTION -->

      <section
        class="concept-introduction"
        aria-labelledby="concept-title"
      >

        {% if concept.concept_number %}
          <p class="concept-subject">
            {{ concept.subject | upcase | escape }}
            | CONCEPT {{ concept.concept_number | escape }}
          </p>
        {% else %}
          <p class="concept-subject">
            {{ concept.subject | escape }}
          </p>
        {% endif %}

        <h1 id="concept-title">
          {{ concept.title | escape }}
        </h1>

        {% if concept.subtitle %}
          <p class="concept-subtitle">
            {{ concept.subtitle | escape }}
          </p>
        {% endif %}

        {% if concept.guiding_question %}
          <p class="concept-guiding-question">
            {{ concept.guiding_question | escape }}
          </p>
        {% endif %}

        {% if concept.description %}
          <p class="concept-description">
            {{ concept.description | escape }}
          </p>
        {% endif %}

      </section>


      <!-- LEARNING OBJECTIVES -->

      {% if concept.learning_objectives %}
        <section
          class="learning-objectives"
          aria-labelledby="learning-objectives-title"
        >

          <h2 id="learning-objectives-title">
            What you will learn
          </h2>

          <ul>
            {% for objective in concept.learning_objectives %}
              <li>
                {{ objective.text | escape }}
              </li>
            {% endfor %}
          </ul>

        </section>
      {% endif %}


      <!-- REUSABLE EDUCATIONAL CONTENT -->

      <section
        class="concept-content"
        aria-labelledby="concept-content-title"
      >

        <h2 id="concept-content-title">
          Explore the concept
        </h2>

        {% for content_id in concept.content_blocks %}

          {% assign content_block = site.learning_content
            | where: "content_block_id", content_id
            | first
          %}

          {% if content_block %}

            {% include concept/content-block.html
              content_block=content_block
            %}

          {% else %}

            <p class="error-message">
              Content block not found:
              {{ content_id | escape }}
            </p>

          {% endif %}

        {% endfor %}

      </section>

    {% else %}

      <!-- CONCEPT NOT FOUND -->

      <section class="error-message">
        <h1>Concept not found</h1>

        <p>
          The requested concept record could not be located.
        </p>
      </section>

    {% endif %}

  </main>


  <!-- =====================================
       IKL SHARED FOOTER
       ===================================== -->

  <footer class="site-footer">

    <p>
      Interactive Knowledge Lexicon |
      Explore. Understand. Experiment.
    </p>

    <p>Created by Amir Khan.</p>

  </footer>

</body>
</html>
