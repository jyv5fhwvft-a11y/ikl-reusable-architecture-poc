---
{% assign concept = site.data.concepts[page.concept_slug] %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ concept.title | escape }} | Interactive Knowledge Lexicon</title>

  <meta name="description" content="{{ concept.description | escape }}">
  <meta name="theme-color" content="#102A43">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/css/proof.css' | relative_url }}">
</head>

<body>

  <a href="{{ '/' | relative_url }}" class="home-button">
    ← Return to Homepage
  </a>

  {% if concept %}

  <!-- CONCEPT HERO — MATCHES PRODUCTION PING -->

  <header class="concept-hero">

    <p class="concept-subject">
      {{ concept.subject | upcase | escape }}
      {% if concept.concept_number %}
        | CONCEPT {{ concept.concept_number | escape }}
      {% endif %}
    </p>

    <h1>{{ concept.title | escape }}</h1>

    {% if concept.guiding_question %}
      <h2>{{ concept.guiding_question | escape }}</h2>
    {% endif %}

    {% if concept.subtitle %}
      <p class="concept-subtitle">
        {{ concept.subtitle | escape }}
      </p>
    {% endif %}

    {% if concept.description %}
      <p class="concept-description">
        {{ concept.description | escape }}
      </p>
    {% endif %}

  </header>

  <main class="concept-container">

    {% if concept.learning_objectives %}
    <section class="learning-objectives">

      <h2>What You Will Learn</h2>

      <ul>
        {% for objective in concept.learning_objectives %}
          <li>{{ objective.text | escape }}</li>
        {% endfor %}
      </ul>

    </section>
    {% endif %}

    <div class="concept-content">

      <h2 class="content-heading">Explore the Concept</h2>

      {% for content_id in concept.content_blocks %}

        {% assign content_block = site.learning_content
          | where: "content_block_id", content_id
          | first
        %}

        {% if content_block %}

          {% include concept/content-block.html
            content_block=content_block
          %}

        {% else %}

          <section class="error-message">
            <p>
              Content block not found:
              {{ content_id | escape }}
            </p>
          </section>

        {% endif %}

      {% endfor %}

    </div>

  </main>

  {% else %}

  <main class="concept-container">
    <section class="error-message">
      <h1>Concept not found</h1>
      <p>The requested concept record could not be located.</p>
    </section>
  </main>

  {% endif %}

  <footer class="site-footer">
    <p class="footer-brand">
      Interactive Knowledge Lexicon |
      Explore. Understand. Experiment.
    </p>
    <p class="footer-credit">Created by Amir Khan.</p>
  </footer>

</body>
</html>
